// Cloudflare Workers, serving the static export in out/ with no Worker script (ADR 0004).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webmedtools-app",
  "compatibility_date": "2026-09-23",
  // Every deploy makes the Worker's domains match these routes, so add a domain here, never only in the dashboard.
  // The workers.dev address is off (ADR 0004).
  "routes": [{ "pattern": "webmedtools.com", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
