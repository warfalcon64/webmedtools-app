// Cloudflare Workers, serving the static export in out/ with no Worker script (ADR 0004).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webmedtools-app",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
